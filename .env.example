# Laravel "LW Events" API (same backend as BFLS)
NEXT_PUBLIC_API_BASE_URL=http://localhost/lex-witness-events/api

# Asset base URLs served by the API
NEXT_PUBLIC_SPEAKERS_BASE_URL=
NEXT_PUBLIC_OFFICIAL_MESSAGE_BASE_URL=
NEXT_PUBLIC_SPONSORS_BASE_URL=
NEXT_PUBLIC_PASTEDITIONS_BASE_URL=
NEXT_PUBLIC_GALLERY_BASE_URL=
NEXT_PUBLIC_REPORT_BASE_URL=
# Optional; defaults to <API host>/uploads/cities/
NEXT_PUBLIC_CITIES_BASE_URL=

# Google reCAPTCHA v3 (Get Involved and Register Your Interest forms)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_V3=

# Public site URL, used for Open Graph/Twitter metadata
NEXT_PUBLIC_SITE_URL=https://grandmasters-fe.vercel.app
